public class ArrayExploder {

    public static Dataset<Row> explodeAndFlattenStructColumn(final Dataset<Row> dataset, String columnToExplode) {
        StructType schema = dataset.schema();

        // Find the array column that needs to be exploded and ensure it's a Struct inside the array
        StructField arrayField = schema.apply(columnToExplode);
        if (!(arrayField.dataType() instanceof ArrayType)) {
            throw new IllegalArgumentException("Column " + columnToExplode + " is not an array.");
        }

        ArrayType arrayType = (ArrayType) arrayField.dataType();
        if (!(arrayType.elementType() instanceof StructType)) {
            throw new IllegalArgumentException("Elements of array " + columnToExplode + " are not structs.");
        }

        StructType structType = (StructType) arrayType.elementType();

        // Explode the array column
        Dataset<Row> explodedDataset = dataset.withColumn(columnToExplode, explode(col(columnToExplode)));

        // Prepare a list to hold the columns we want to select
        Column[] columns = new Column[schema.size() + structType.size()];
        int idx = 0;

        // Add original columns (except the exploded one)
        for (StructField field : schema.fields()) {
            String colName = field.name();
            if (!colName.equals(columnToExplode)) {
                columns[idx++] = col(colName);
            }
        }

        // Dynamically extract struct fields from the exploded array
        for (StructField structField : structType.fields()) {
            String fieldName = structField.name();
            columns[idx++] = col(columnToExplode + "." + fieldName).as(fieldName);
        }

        // Return the dataset with the exploded and flattened struct fields
        return explodedDataset.select(columns);
    }
}


  public static Dataset<Row> explodeArray(Dataset<Row> dataset) {
        StructType schema = dataset.schema();
        List<Column> selectExprs = new ArrayList<>();

        for (StructField field : schema.fields()) {
            if (field.dataType().equals(ArrayType.apply(DataTypes.StringType))) {
                // If the field is an array of strings, explode it
                selectExprs.add(functions.explode(field.name()).alias(field.name()));
            } else {
                // Otherwise, keep the column as is
                selectExprs.add(field.name());
            }
        }

        return dataset.selectExpr(selectExprs.toArray(new Column[0]));

public static Dataset<Row> explodeAndFlattenArrays(Dataset<Row> dataset) {
    StructType schema = dataset.schema();
    Dataset<Row> transformedDataset = dataset;

    // Iterate over each field in the schema to check for array types
    for (StructField field : schema.fields()) {
        if (field.dataType() instanceof ArrayType) {
            // Explode the array column
            transformedDataset = transformedDataset.withColumn(field.name(), explode(col(field.name())));

            // Check if the array elements are structs and flatten them if they are
            ArrayType arrayType = (ArrayType) field.dataType();
            if (arrayType.elementType() instanceof StructType) {
                StructType structType = (StructType) arrayType.elementType();
                
                // For each field in the struct, create a new column with the exploded element's field
                for (StructField nestedField : structType.fields()) {
                    String newColName = field.name() + "_" + nestedField.name();
                    transformedDataset = transformedDataset.withColumn(newColName, col(field.name() + "." + nestedField.name()));
                }

                // Drop the original exploded struct column
                transformedDataset = transformedDataset.drop(field.name());
            }
        }
    }

    return transformedDataset;
}

 @Test
    public void testExplodeArrayWithDefaultColumn() {
        // Create schema matching the input structure
        StructType elementSchema = new StructType()
            .add("flow_result_flow_date", DataTypes.DateType, true)
            .add("ccf_flow_amt", DataTypes.createDecimalType(38, 9), true)
            .add("ccf_flow_amt_base", DataTypes.createDecimalType(38, 9), true);
            
        StructType arraySchema = new StructType()
            .add("twd_original_contractual_cashflow_sorted_array", 
                 DataTypes.createArrayType(elementSchema), true)
            .add("contractual_cashflow_sorted_array", 
                 DataTypes.createArrayType(elementSchema), true);
                 
        // Create test data
        List<Row> testData = Arrays.asList(
            RowFactory.create(
                Arrays.asList(
                    RowFactory.create(
                        Date.valueOf("2024-01-01"),
                        new BigDecimal("1000.123456789"),
                        new BigDecimal("1000.123456789")
                    )
                ),
                Arrays.asList(
                    RowFactory.create(
                        Date.valueOf("2024-01-01"),
                        new BigDecimal("2000.123456789"),
                        new BigDecimal("2000.123456789")
                    )
                )
            )
        );
        
        Dataset<Row> inputDF = spark.createDataFrame(testData, arraySchema);
        
        // Test the explodeArray method
        Dataset<Row> result = YourClass.explodeArray(inputDF);
        
        // Verify results
        assertEquals(2, result.count()); // Should have 2 rows after explosion
        assertTrue(result.columns().contains("flow_result_flow_date"));
        assertTrue(result.columns().contains("ccf_flow_amt"));
        assertTrue(result.columns().contains("ccf_flow_amt_base"));
    }
    
